<script>

/*
==================================================
ERROR
==================================================
*/

const errorContainer =
    document.getElementById("error");

/*
==================================================
MINI BANNER COUNT TRACKING
==================================================
*/

function updateMiniBannerCount(
    id,
    count,
    key
) {

    const element =
        document.getElementById(id);

    if (!element) {
        return;
    }

    const currentCount =
        Number(count) || 0;

    element.dataset.currentCount =
        currentCount;

    const acknowledged =
        Number(
            localStorage.getItem(
                "talknaija_admin_" + key
            )
        ) || 0;

    const newCount =
        Math.max(
            0,
            currentCount - acknowledged
        );

    element.textContent =
        newCount;

}


function openMiniBanner(
    id,
    key,
    url
) {

    const element =
        document.getElementById(id);

    const currentCount =
        element
        ? Number(
            element.dataset.currentCount
        ) || 0
        : 0;

    localStorage.setItem(
        "talknaija_admin_" + key,
        currentCount
    );

    window.location.href =
        url;

}


/*
==================================================
STATS
==================================================
*/

async function loadStats() {

    try {

        const response =
            await fetch("/api/admin/stats");

        if (!response.ok) {

            throw new Error(
                "Failed to load admin statistics."
            );

        }

        const stats =
            await response.json();

        /*
        ================================================
        TOP MINI BANNERS
        ================================================
        */

        const reports =
            document.getElementById("miniReports");

        const mail =
            document.getElementById("miniMail");

        const actionTaken =
            document.getElementById("miniActionTaken");

        const red =
            document.getElementById("miniRed");


	if (reports) {

	    updateMiniBannerCount(
	        "miniReports",
	        stats.totalReports || 0,
	        "reports"
	    );

	}

        if (mail) {

            /*
            Mail is loaded separately by
            loadTickets().
            */

        }


	if (actionTaken) {

	    updateMiniBannerCount(
	        "miniActionTaken",
	        stats.actionTakenReports || 0,
	        "actionTaken"
	    );

	}

	if (red) {

	    updateMiniBannerCount(
	        "miniRed",
	        stats.redAccounts || 0,
	        "red"
	    );

	}


    } catch (error) {

        console.error(
            "Admin statistics error:",
            error
        );

        /*
        Don't show the old global error anymore.
        The dashboard can still load the other sections.
        */

    }

}


/*
==================================================
RED ACCOUNTS
==================================================
*/

async function loadRedAccounts() {

    const container =
        document.getElementById("redAccounts");

    try {

        const response =
            await fetch("/api/admin/red-accounts");

        if (!response.ok) {

            throw new Error(
                "Failed to load red accounts."
            );

        }

        const accounts =
            await response.json();

        if (!accounts.length) {

            container.innerHTML = `
                <div class="empty">
                    No red accounts currently.
                </div>
            `;

            return;

        }

        container.innerHTML =
            accounts
                .slice(0, 3)
                .map(
                    (account) => `
                        <div class="red-account">

                            <div>

                                <div>

                                    <strong>
                                        ${escapeHtml(account.userId)}
                                    </strong>

                                </div>

                                <div class="red-label">
                                    ${account.reports}
                                    reports
                                </div>

                            </div>

                        </div>
                    `
                )
                .join("");

    } catch (error) {

        console.error(error);

        container.innerHTML = `
            <div class="error">
                Could not load red accounts.
            </div>
        `;

    }

}


/*
==================================================
REPORTS
==================================================
*/

async function loadReports() {

    const container =
        document.getElementById("reports");

    try {

        const response =
            await fetch("/api/reports");

        if (!response.ok) {

            throw new Error(
                "Failed to load reports."
            );

        }

        const reports =
            await response.json();

        if (!reports.length) {

            container.innerHTML = `
                <div class="empty">

                    <h3>
                        No reports
                    </h3>

                    <p>
                        There are currently
                        no user reports.
                    </p>

                </div>
            `;

            return;

        }

        container.innerHTML =
            reports
                .slice()
                .reverse()
                .slice(0, 3)
                .map(
                    (report) => `
                        <div class="report">

                            <div class="report-header">

                                <div class="reason">
                                    🚨
                                    ${escapeHtml(report.reason)}
                                </div>

                                <div class="status">
                                    ${escapeHtml(report.status)}
                                </div>

                            </div>

                            <div class="details">

                                <div>

                                    <strong>
                                        Reporter:
                                    </strong>

                                    ${escapeHtml(report.reporter)}

                                </div>

                                <div>

                                    <strong>
                                        Reported:
                                    </strong>

                                    ${escapeHtml(report.reported)}

                                </div>

                                <div>

                                    <strong>
                                        Created:
                                    </strong>

                                    ${new Date(
                                        report.createdAt
                                    ).toLocaleString()}

                                </div>

                            </div>

                            <div class="actions">

                                <button
                                    class="blue"
                                    onclick="updateReport(
                                        '${report.id}',
                                        'reviewed'
                                    )"
                                >
                                    Mark Reviewed
                                </button>

                                <button
                                    class="danger"
                                    onclick="updateReport(
                                        '${report.id}',
                                        'action_taken'
                                    )"
                                >
                                    Action Taken
                                </button>

                                <button
                                    class="primary"
                                    onclick="${
                                        report.blocked
                                            ? `unblockPair('${report.id}')`
                                            : `blockPair('${report.id}')`
                                    }"
                                >
                                    ${
                                        report.blocked
                                            ? "🔓 Unblock Pair"
                                            : "🚫 Block Pair"
                                    }
                                </button>

                                <button
                                    class="muted"
                                    onclick="updateReport(
                                        '${report.id}',
                                        'dismissed'
                                    )"
                                >
                                    Dismiss
                                </button>

                            </div>

                        </div>
                    `
                )
                .join("");

    } catch (error) {

        console.error(error);

        container.innerHTML = `
            <div class="error">
                Could not load reports.
            </div>
        `;

    }

}


/*
==================================================
BLOCK PAIR
==================================================
*/

async function blockPair(id) {

    if (!confirm(
        "Block these two users from being matched with each other again?"
    )) {
        return;
    }

    try {

        const response = await fetch(
            `/api/reports/${id}/block`,
            {
                method: "POST"
            }
        );

        if (!response.ok) {
            throw new Error("Failed to block pair.");
        }

        alert("Pair blocked successfully.");

        await loadReports();
        await loadStats();
        await loadRedAccounts();

    } catch (error) {

        console.error(error);

        alert("Could not block this pair.");

    }

}

/*
==================================================
UNBLOCK PAIR
==================================================
*/

async function unblockPair(id) {

    if (!confirm(
        "Allow these two users to be matched with each other again?"
    )) {
        return;
    }

    try {

        const response = await fetch(
            `/api/reports/${id}/unblock`,
            {
                method: "POST"
            }
        );

        if (!response.ok) {
            throw new Error(
                "Failed to unblock pair."
            );
        }

        alert(
            "Pair unblocked successfully."
        );

        await loadReports();
        await loadStats();

    } catch (error) {

        console.error(error);

        alert(
            "Could not unblock this pair."
        );

    }

}


/*
==================================================
UPDATE REPORT
==================================================
*/

async function updateReport(id, status) {

    try {

        const response = await fetch(
            `/api/reports/${id}`,
            {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    status
                })
            }
        );

        if (!response.ok) {
            throw new Error(
                "Failed to update report."
            );
        }

        await loadReports();
        await loadStats();

    } catch (error) {

        console.error(error);

        alert(
            "Could not update the report."
        );

