+/*
+==================================================
+MINI BANNER COUNT TRACKING
+==================================================
+*/
+
+function updateMiniBannerCount(
+    id,
+    count,
+    key
+) {
+
+    const element =
+        document.getElementById(id);
+
+    if (!element) {
+        return;
+    }
+
+    const currentCount =
+        Number(count) || 0;
+
+    element.dataset.currentCount =
+        currentCount;
+
+    const acknowledged =
+        Number(
+            localStorage.getItem(
+                "talknaija_admin_" + key
+            )
+        ) || 0;
+
+    const newCount =
+        Math.max(
+            0,
+            currentCount - acknowledged
+        );
+
+    element.textContent =
+        newCount;
+
+}
+
+
+function openMiniBanner(
+    id,
+    key,
+    url
+) {
+
+    const element =
+        document.getElementById(id);
+
+    const currentCount =
+        element
+        ? Number(
+            element.dataset.currentCount
+        ) || 0
+        : 0;
+
+    localStorage.setItem(
+        "talknaija_admin_" + key,
+        currentCount
+    );
+
+    window.location.href =
+        url;
+
+}
+
 
