<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>TalkNaija Admin</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 20px;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #111;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        .header {
            background: #0d1730;
            color: white;
            border-radius: 15px;
            padding: 22px;
            margin-bottom: 20px;
        }

        .header h1 {
            margin: 0 0 6px;
        }

        .header p {
            margin: 0;
            opacity: 0.75;
        }

        .page {
            background: white;
            border-radius: 14px;
            padding: 20px;
            box-shadow:
                0 2px 8px rgba(0,0,0,0.08);
        }

        .back {
            display: inline-block;
            margin-bottom: 18px;
            padding: 10px 14px;
            border-radius: 8px;
            background: #111;
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        @media (max-width: 600px) {

            body {
                padding: 12px;
            }

            .header {
                padding: 18px;
            }

            .page {
                padding: 15px;
            }

        }

    </style>

</head>

<body>

<div class="container">

    <header class="header">

        <h1>
            TalkNaija Admin
        </h1>

        <p>
            Moderation & Support Control Center
        </p>

    </header>

<main class="page">

    <a
        href="/admin.html"
        class="back"
    >
        ← Back to Dashboard
    </a>

    <h2>
        Red Accounts
    </h2>

    <p>
        Accounts that have reached 5 reports.
    </p>

    <div id="redAccounts">
        Loading...
    </div>

</main>

<script>

async function loadRedAccounts() {

    const container =
        document.getElementById(
            "redAccounts"
        );

    try {

        const response =
            await fetch(
                "/api/admin/red-accounts"
            );

        if (!response.ok) {
            throw new Error(
                "Failed to load red accounts."
            );
        }

        const accounts =
            await response.json();

        if (!accounts.length) {

            container.innerHTML = `
                <p>
                    No red accounts.
                </p>
            `;

            return;
        }

        container.innerHTML =
            accounts.map(
                (account) => `

                    <div
                        style="
                            border:1px solid #ddd;
                            border-radius:12px;
                            padding:16px;
                            margin-top:12px;
                            background:#fafafa;
                        "
                    >

                        <div
                            style="
                                font-weight:bold;
                                margin-bottom:8px;
                            "
                        >
                            🔴 ${escapeHtml(
                                account.userId
                            )}
                        </div>

                        <div
                            style="
                                margin-bottom:12px;
                            "
                        >
                            Reports:
                            <strong>
                                ${account.reports}
                            </strong>
                        </div>

                        <button
                            onclick="unbanUser(
                                '${escapeJs(
                                    account.userId
                                )}'
                            )"
                            style="
                                background:#198754;
                                color:white;
                                border:0;
                                padding:10px 16px;
                                border-radius:8px;
                                font-weight:bold;
                                cursor:pointer;
                            "
                        >
                            Unban
                        </button>

                    </div>

                `
            ).join("");

    } catch (error) {

        container.innerHTML = `
            <div
                style="
                    color:#b00020;
                    padding:12px;
                "
            >
                Could not load red accounts.
            </div>
        `;

        console.error(error);

    }

}


async function unbanUser(uuid) {

    const confirmed =
        confirm(
            "Unban this account and reset its current report count?"
        );

    if (!confirmed) {
        return;
    }

    try {

        const response =
            await fetch(
                "/api/admin/red-accounts/" +
                encodeURIComponent(uuid) +
                "/unban",
                {
                    method: "POST"
                }
            );

        const data =
            await response.json();

        if (!response.ok) {

            throw new Error(
                data.error ||
                "Failed to unban user."
            );

        }

        alert(
            "User unbanned successfully."
        );

        loadRedAccounts();

    } catch (error) {

        alert(
            error.message
        );

        console.error(error);

    }

}


function escapeHtml(value) {

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


function escapeJs(value) {

    return String(value)
        .replace(/\\/g, "\\\\")
        .replace(/'/g, "\\'");

}


loadRedAccounts();

</script>

</div>

</body>

</html>
