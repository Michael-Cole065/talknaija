            display:flex;
            justify-content:center;
            gap:12px;
            margin-top:10px;
        `;

        const acceptBtn =
            document.createElement(
                "button"
            );

        acceptBtn.textContent =
            "Accept";

        acceptBtn.type =
            "button";

        acceptBtn.style.cssText = `
            background:#2563eb;
            color:#fff;
            border:none;
            border-radius:10px;
            padding:12px 20px;
            width:115px;
            min-width:115px;
