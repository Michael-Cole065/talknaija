        if (!localStream) {

            console.log(
                "🎤 No microphone stream available."
            );

            return;

        }


        const audioTracks =
            localStream.getAudioTracks();


        if (
            audioTracks.length ===
            0
        ) {

            console.log(
                "❌ No audio track found."
            );

            return;

        }


        isMuted =
            !isMuted;


        audioTracks.forEach(
            (track) => {

                track.enabled =
                    !isMuted;

            }
        );


        if (isMuted) {

            muteBtn.textContent =
                "Unmute";

            debugLog(
                "🔇 MICROPHONE MUTED"
            );

        } else {

            muteBtn.textContent =
