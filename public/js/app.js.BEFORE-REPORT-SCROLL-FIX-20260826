        muteBtn.textContent =
            "Mute";


        timerInterval =
            setInterval(
                () => {

                    seconds++;

                    const mins =
                        Math.floor(
                            seconds /
                            60
                        );

                    const secs =
                        seconds %
                        60;


                    timer.textContent =
                        String(
                            mins
                        ).padStart(
                            2,
                            "0"
                        ) +
                        ":" +
                        String(
                            secs
                        ).padStart(
                            2,
                            "0"
                        );

                },
                1000
            );

    }
);


